{{%
import Fmt
## The menu page. Declared rather than inferred, because the prices are
## numbers, which a printed path alone would take for a `Str`.
Ctx : { title : Str, items : List({ name : Str, price : U32 }) }
%}}
<!doctype html>
<html lang="en">
<meta charset="utf-8">
<title>{{ title }}</title>
<h1>{{ title }}</h1>
<p>{{ Fmt.plural(items.len(), "dish", "dishes") }} on the menu.</p>
<ul>
{{#items |item|}}  <li>{{ item.name }}: {{ item.price.to_str() }} kr</li>
{{/items}}</ul>
{{^items}}<p>The kitchen is closed.</p>{{/items}}
</html>
