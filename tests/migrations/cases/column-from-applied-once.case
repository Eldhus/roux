Prices move from kronor to öre in release 1, and the lines stay in
schema.sql through release 2, which rebuilds the table again (a note is
added). The database is at release 1 then, so the lines still apply, and
the @from fills only a column new to its table: the prices are not
multiplied a second time. Release 3 removes the lines and says so
(`@oldest 2`): nothing to do.

== before
CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL, price_kr INTEGER NOT NULL) STRICT;
INSERT INTO dish VALUES (1, 'soup', 95), (2, 'bread', 40);

== after
-- @release 1
-- @drop 1 column dish price_kr
-- @from 1 column dish price_ore = price_kr * 100
CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL, price_ore INTEGER NOT NULL) STRICT;

== after
-- @release 2
-- @drop 1 column dish price_kr
-- @from 1 column dish price_ore = price_kr * 100
CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL, price_ore INTEGER NOT NULL, note TEXT) STRICT;

== after
-- @release 3
-- @oldest 2
CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL, price_ore INTEGER NOT NULL, note TEXT) STRICT;

== query
SELECT id, name, price_ore FROM dish ORDER BY id

== plan
-- after 1
roux: migrating test.db, 4 steps
  table `dish`: aside, to make it anew
    ALTER TABLE "dish" RENAME TO "roux_old_dish"
  table `dish`: as schema.sql makes it
    CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL, price_ore INTEGER NOT NULL) STRICT
  table `dish`: its rows, by id, name, price_ore = price_kr * 100
    INSERT INTO "dish" ("id", "name", "price_ore") SELECT "id", "name", (
    price_kr * 100
    ) FROM "roux_old_dish"
  table `dish`: the old one
    DROP TABLE "roux_old_dish"
migrated from release 0
-- after 2
roux: migrating test.db, 4 steps
  table `dish`: aside, to make it anew
    ALTER TABLE "dish" RENAME TO "roux_old_dish"
  table `dish`: as schema.sql makes it
    CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL, price_ore INTEGER NOT NULL, note TEXT) STRICT
  table `dish`: its rows, by id, name, price_ore
    INSERT INTO "dish" ("id", "name", "price_ore") SELECT "id", "name", "price_ore" FROM "roux_old_dish"
  table `dish`: the old one
    DROP TABLE "roux_old_dish"
migrated from release 1
