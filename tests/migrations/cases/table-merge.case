Two tables merged into one: `lunch` renamed `meal`, `dinner`'s rows moved
into it (new keys, so none collide), and `dinner` dropped.

== before
CREATE TABLE lunch (id INTEGER PRIMARY KEY, title TEXT NOT NULL) STRICT;
CREATE TABLE dinner (id INTEGER PRIMARY KEY, title TEXT NOT NULL) STRICT;
INSERT INTO lunch VALUES (1, 'soup');
INSERT INTO dinner VALUES (1, 'roast');

== after
CREATE TABLE meal (id INTEGER PRIMARY KEY, title TEXT NOT NULL) STRICT;

== ledger
ALTER TABLE lunch RENAME TO meal;
INSERT INTO meal (title) SELECT title FROM dinner ORDER BY id;
DROP TABLE dinner;

== plan
roux: migrating test.db, ledger.sql's steps 1 to 3
  step 1
    ALTER TABLE lunch RENAME TO meal;
  step 2
    INSERT INTO meal (title) SELECT title FROM dinner ORDER BY id;
  step 3
    DROP TABLE dinner;
roux: migrating test.db, 4 steps
  table `meal`: aside, to make it anew
    ALTER TABLE "meal" RENAME TO "roux_old_meal"
  table `meal`: as schema.sql makes it
    CREATE TABLE meal (id INTEGER PRIMARY KEY, title TEXT NOT NULL) STRICT
  table `meal`: its rows, by id, title
    INSERT INTO "meal" ("id", "title") SELECT "id", "title" FROM "roux_old_meal"
  table `meal`: the old one
    DROP TABLE "roux_old_meal"

== query
SELECT id, title FROM meal ORDER BY id

== rows
1 | soup
2 | roast
