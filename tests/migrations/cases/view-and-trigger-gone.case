A view and its INSTEAD OF trigger both leave schema.sql: one DROP VIEW
takes them both.

== before
CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL) STRICT;
CREATE VIEW dishes AS SELECT id, name FROM dish;
CREATE TRIGGER add_dish INSTEAD OF INSERT ON dishes BEGIN INSERT INTO dish (name) VALUES (new.name); END;
INSERT INTO dish (name) VALUES ('soup');

== after
CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL) STRICT;

== plan
roux: migrating test.db, 1 step
  view `dishes`: not in schema.sql
    DROP VIEW "dishes"
