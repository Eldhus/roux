roux: migrating test.db, 4 steps
  table `dish`: aside, to make it anew
    ALTER TABLE "dish" RENAME TO "roux_old_dish"
  table `dish`: as schema.sql makes it
    CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL, slug TEXT NOT NULL, note TEXT NOT NULL) STRICT
  table `dish`: its rows, by id, name, slug, note
    INSERT INTO "dish" ("id", "name", "slug", "note") SELECT "id", "name", "slug", "note" FROM "roux_old_dish"
  table `dish`: the old one
    DROP TABLE "roux_old_dish"

== query
SELECT id, name, slug, note FROM dish ORDER BY id

