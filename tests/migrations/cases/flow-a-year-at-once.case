flow-a-year-of-releases' database, deployed straight from its first
release to its last: the year's five steps run in order, each on what the
one before left (the rename before the prices that use the new name), then
schema.sql's changes. The rows end as they do release by release.

== before
CREATE TABLE menu (id INTEGER PRIMARY KEY, title TEXT NOT NULL) STRICT;
CREATE TABLE dish (id INTEGER PRIMARY KEY, title TEXT NOT NULL, price_kr INTEGER NOT NULL) STRICT;
CREATE TABLE course (id INTEGER PRIMARY KEY, menu_id INTEGER NOT NULL REFERENCES menu (id), dish_id INTEGER NOT NULL REFERENCES dish (id)) STRICT;
INSERT INTO menu VALUES (1, 'lunch'), (2, 'dinner');
INSERT INTO dish VALUES (1, 'soup', 95), (2, 'bread', 40), (3, 'roast', 240);
INSERT INTO course VALUES (1, 1, 1), (2, 1, 2), (3, 2, 3);

== after
CREATE TABLE meal (id INTEGER PRIMARY KEY, title TEXT NOT NULL) STRICT;
CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL, note TEXT, price_ore INTEGER NOT NULL) STRICT;
CREATE INDEX dish_by_name ON dish (name);
CREATE TABLE course (id INTEGER PRIMARY KEY, menu_id INTEGER NOT NULL REFERENCES meal (id), dish_id INTEGER NOT NULL REFERENCES dish (id)) STRICT;

== ledger
ALTER TABLE dish RENAME COLUMN title TO name;
-- Prices in öre.
ALTER TABLE dish ADD COLUMN price_ore INTEGER;
UPDATE dish SET price_ore = price_kr * 100;
ALTER TABLE dish DROP COLUMN price_kr;
ALTER TABLE menu RENAME TO meal;

== plan
roux: migrating test.db, ledger.sql's steps 1 to 5
  step 1
    ALTER TABLE dish RENAME COLUMN title TO name;
  step 2
    ALTER TABLE dish ADD COLUMN price_ore INTEGER;
  step 3
    UPDATE dish SET price_ore = price_kr * 100;
  step 4
    ALTER TABLE dish DROP COLUMN price_kr;
  step 5
    ALTER TABLE menu RENAME TO meal;
roux: migrating test.db, 13 steps
  table `meal`: aside, to make it anew
    ALTER TABLE "meal" RENAME TO "roux_old_meal"
  table `meal`: as schema.sql makes it
    CREATE TABLE meal (id INTEGER PRIMARY KEY, title TEXT NOT NULL) STRICT
  table `meal`: its rows, by id, title
    INSERT INTO "meal" ("id", "title") SELECT "id", "title" FROM "roux_old_meal"
  table `meal`: the old one
    DROP TABLE "roux_old_meal"
  table `dish`: aside, to make it anew
    ALTER TABLE "dish" RENAME TO "roux_old_dish"
  table `dish`: as schema.sql makes it
    CREATE TABLE dish (id INTEGER PRIMARY KEY, name TEXT NOT NULL, note TEXT, price_ore INTEGER NOT NULL) STRICT
  table `dish`: its rows, by id, name, price_ore
    INSERT INTO "dish" ("id", "name", "price_ore") SELECT "id", "name", "price_ore" FROM "roux_old_dish"
  table `dish`: the old one
    DROP TABLE "roux_old_dish"
  table `course`: aside, to make it anew
    ALTER TABLE "course" RENAME TO "roux_old_course"
  table `course`: as schema.sql makes it
    CREATE TABLE course (id INTEGER PRIMARY KEY, menu_id INTEGER NOT NULL REFERENCES meal (id), dish_id INTEGER NOT NULL REFERENCES dish (id)) STRICT
  table `course`: its rows, by id, menu_id, dish_id
    INSERT INTO "course" ("id", "menu_id", "dish_id") SELECT "id", "menu_id", "dish_id" FROM "roux_old_course"
  table `course`: the old one
    DROP TABLE "roux_old_course"
  index `dish_by_name`: as schema.sql makes it
    CREATE INDEX dish_by_name ON dish (name)

== query
SELECT meal.title, dish.name, dish.price_ore FROM course JOIN meal ON meal.id = course.menu_id JOIN dish ON dish.id = course.dish_id ORDER BY course.id

