A table renamed, `menu` to `meal`: dropped on purpose, and the new one
made from its rows. Its AUTOINCREMENT goes on, its index is made for the
new name, and the table whose rows refer to it (rebuilt, since its CREATE
now names `meal`) keeps every row.

== before
CREATE TABLE menu (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL) STRICT;
CREATE INDEX menu_by_title ON menu (title);
CREATE TABLE course (id INTEGER PRIMARY KEY, menu_id INTEGER NOT NULL REFERENCES menu (id), name TEXT NOT NULL) STRICT;
INSERT INTO menu (title) VALUES ('lunch'), ('dinner'), ('late');
DELETE FROM menu WHERE title = 'late';
INSERT INTO course VALUES (1, 1, 'soup'), (2, 2, 'roast');

== after
-- @release 1
-- @drop 1 table menu
-- @from 1 table meal = menu
CREATE TABLE meal (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL) STRICT;
CREATE INDEX meal_by_title ON meal (title);
CREATE TABLE course (id INTEGER PRIMARY KEY, menu_id INTEGER NOT NULL REFERENCES meal (id), name TEXT NOT NULL) STRICT;

== query
SELECT meal.id, meal.title, course.name, (SELECT seq FROM sqlite_sequence WHERE name = 'meal') FROM course JOIN meal ON meal.id = course.menu_id ORDER BY course.id

== plan
roux: migrating test.db, 10 steps
  table `meal`: `menu` aside, to make it from
    ALTER TABLE "menu" RENAME TO "roux_old_menu"
  table `meal`: as schema.sql makes it
    CREATE TABLE meal (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL) STRICT
  table `meal`: AUTOINCREMENT goes on from where it was
    INSERT INTO sqlite_sequence (name, seq) SELECT 'meal', seq FROM sqlite_sequence WHERE name = 'roux_old_menu'
  table `meal`: its rows, by id, title
    INSERT INTO "meal" ("id", "title") SELECT "id", "title" FROM "roux_old_menu"
  table `meal`: the old one
    DROP TABLE "roux_old_menu"
  table `course`: aside, to make it anew
    ALTER TABLE "course" RENAME TO "roux_old_course"
  table `course`: as schema.sql makes it
    CREATE TABLE course (id INTEGER PRIMARY KEY, menu_id INTEGER NOT NULL REFERENCES meal (id), name TEXT NOT NULL) STRICT
  table `course`: its rows, by id, menu_id, name
    INSERT INTO "course" ("id", "menu_id", "name") SELECT "id", "menu_id", "name" FROM "roux_old_course"
  table `course`: the old one
    DROP TABLE "roux_old_course"
  index `meal_by_title`: as schema.sql makes it
    CREATE INDEX meal_by_title ON meal (title)
migrated from release 0

