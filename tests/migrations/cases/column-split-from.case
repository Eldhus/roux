One column split in two: each new column filled by its own expression
over the old row, the old column dropped on purpose.

== before
CREATE TABLE cook (id INTEGER PRIMARY KEY, name TEXT NOT NULL) STRICT;
INSERT INTO cook VALUES (1, 'Ada Lovelace'), (2, 'Grace Hopper');

== after
-- @release 1
-- @drop 1 column cook name
-- @from 1 column cook first_name = substr(name, 1, instr(name, ' ') - 1)
-- @from 1 column cook last_name = substr(name, instr(name, ' ') + 1)
CREATE TABLE cook (id INTEGER PRIMARY KEY, first_name TEXT NOT NULL, last_name TEXT NOT NULL) STRICT;

== query
SELECT id, first_name, last_name FROM cook ORDER BY id

== plan
roux: migrating test.db, 4 steps
  table `cook`: aside, to make it anew
    ALTER TABLE "cook" RENAME TO "roux_old_cook"
  table `cook`: as schema.sql makes it
    CREATE TABLE cook (id INTEGER PRIMARY KEY, first_name TEXT NOT NULL, last_name TEXT NOT NULL) STRICT
  table `cook`: its rows, by id, first_name = substr(name, 1, instr(name, ' ') - 1), last_name = substr(name, instr(name, ' ') + 1)
    INSERT INTO "cook" ("id", "first_name", "last_name") SELECT "id", (
    substr(name, 1, instr(name, ' ') - 1)
    ), (
    substr(name, instr(name, ' ') + 1)
    ) FROM "roux_old_cook"
  table `cook`: the old one
    DROP TABLE "roux_old_cook"
migrated from release 0

