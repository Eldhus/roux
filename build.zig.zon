.{
    .name = .roux,
    // roux's version, set here only: build.zig gives it to `roux version`
    // and the release's file names, and a release's tag is it with a `v`.
    .version = "0.6.0",
    .fingerprint = 0xaf6f4fab96f74033,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // fourneau, the server the host runs on: the checkout beside this
        // one (../fourneau), so a change there is built here at once. Both
        // are Eldhus repositories, developed together.
        .fourneau = .{ .path = "../fourneau" },
    },
    .paths = .{ "build.zig", "build.zig.zon", "host", "platform", "sqlite", "vendor", "tools" },
}
